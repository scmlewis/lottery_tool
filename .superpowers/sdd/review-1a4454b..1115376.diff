-    if (!seconds || seconds <= 0) return;
-    state.autoAdvanceRemaining = seconds;
-    updateAutoAdvanceDisplay();
-
-    autoAdvanceTimer = setInterval(() => {
-        state.autoAdvanceRemaining--;
